{
  "name": "langchain-cursor",
  "version": "0.1.0",
  "description": "LangChain chat model for Cursor models via the Cursor Agents SDK (local runtime)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alumnium-hq/langchain-cursor.git"
  },
  "keywords": [
    "langchain",
    "cursor",
    "cursor-agents",
    "composer",
    "chat-model"
  ],
  "author": "Ish Abbi <ishabbi@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.32",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.1.41"
  },
  "devDependencies": {
    "@langchain/core": "^1.1.41",
    "@types/node": "^25.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
